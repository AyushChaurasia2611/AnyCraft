{
  "name": "anycraft-desktop",
  "version": "1.0.0",
  "description": "AnyCraft Desktop App for Windows and macOS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable",
    "build:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.anycraft.desktop",
    "productName": "AnyCraft",
    "win": {
      "target": ["portable"]
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.utilities"
    }
  }
}
